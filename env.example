# Strong random value: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CHANGE_TO_RANDOM_LONG_KEY
# Telegram developer credentials from https://my.telegram.org
TG_API_ID=0
TG_API_HASH=YOUR_TELEGRAM_API_HASH
# Telegram bot token from BotFather
TG_BOT_TOKEN=YOUR_BOT_TOKEN
# Open your bot and send /start to retrieve chat ID from its reply, then set this
TG_CHAT_ID=0
# Server listen port (publish via HTTPS reverse proxy or Cloudflare tunnel)
PORT=8094
VIDEO_HOST=video.badassworks.xyz
MAX_PARTS=300
MAX_TOTAL_GB=3.5
DATA_DIR=./jobs
